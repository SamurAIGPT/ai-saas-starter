# PostgreSQL Connection Parameters
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DIRECT_URL="postgresql://user:password@host:port/database?schema=public"

# NextAuth Authentication Config
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAILS="admin@example.com"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# PayPal Configuration (Updated from Stripe)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_secret_key_here"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"
PAYPAL_ENV="sandbox"
# Optional override; sandbox uses https://api-m.sandbox.paypal.com
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# Legacy Stripe Configuration (optional, kept for backward compatibility)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# MUAPI Application credentials
MUAPIAPP_API_KEY="your_muapi_api_key_here"
WEBHOOK_URL="http://localhost:3000"
MUAPI_WEBHOOK_SECRET="replace_with_a_long_random_secret"
DOWNLOAD_ALLOWED_HOSTS="cdn.muapi.ai,cdn.muapi.com,images.unsplash.com"
